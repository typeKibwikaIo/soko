// Soko DRC — multi-vendor marketplace schema
// Database: PostgreSQL "soko"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RoleName {
  BUYER
  VENDOR
  ADMIN
}

enum VendorVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  INITIAL
  PURCHASE
  RESTOCK
  ADJUSTMENT
  RETURN
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum VendorOrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentRecordStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

// ---------------------------------------------------------------------------
// A. Users & authentication
// ---------------------------------------------------------------------------

model Role {
  id          String       @id @default(uuid())
  name        RoleName     @unique
  description String?
  users       UserRole[]

  @@map("roles")
}

model User {
  id              String     @id @default(uuid())
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  email           String     @unique
  phone           String?
  passwordHash    String     @map("password_hash")
  avatarUrl       String?    @map("avatar_url")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  emailVerificationToken      String?   @map("email_verification_token")
  emailVerificationExpiresAt  DateTime? @map("email_verification_expires_at")
  phoneOtpHash                String?   @map("phone_otp_hash")
  phoneOtpExpiresAt           DateTime? @map("phone_otp_expires_at")
  phoneOtpAttempts            Int       @default(0) @map("phone_otp_attempts")
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  roles           UserRole[]
  buyerProfile    BuyerProfile?
  vendorProfile   VendorProfile?
  addresses       UserAddress[]
  refreshTokens   RefreshToken[]
  carts           Cart[]
  orders          Order[]
  activityLogs    ActivityLog[]
  inventoryMoves  InventoryMovement[]

  @@map("users")
}

model UserRole {
  userId String   @map("user_id")
  roleId String   @map("role_id")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model BuyerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  preferredLanguage String?  @map("preferred_language")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("buyer_profiles")
}

model VendorProfile {
  id                   String                    @id @default(uuid())
  userId               String                    @unique @map("user_id")
  businessName         String?                   @map("business_name")
  businessType         String?                   @map("business_type")
  registrationNumber   String?                   @map("registration_number")
  idNumber             String?                   @map("id_number")
  dateOfBirth          DateTime?                 @map("date_of_birth") @db.Date
  idDocumentFrontUrl   String?                   @map("id_document_front_url")
  idDocumentBackUrl    String?                   @map("id_document_back_url")
  verificationStatus   VendorVerificationStatus  @default(UNVERIFIED) @map("verification_status")
  verificationSubmittedAt DateTime?              @map("verification_submitted_at")
  verificationNote     String?                   @map("verification_note")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shops Shop[]

  @@map("vendor_profiles")
}

model UserAddress {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  fullName     String      @map("full_name")
  phone        String
  addressLine1 String      @map("address_line_1")
  addressLine2 String?     @map("address_line_2")
  city         String
  region       String?
  country      String      @default("DRC")
  postalCode   String?     @map("postal_code")
  addressType  AddressType @default(SHIPPING) @map("address_type")
  isDefault    Boolean     @default(false) @map("is_default")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// B. Vendor shops
// ---------------------------------------------------------------------------

model Shop {
  id               String     @id @default(uuid())
  vendorId         String     @map("vendor_id")
  shopName         String     @map("shop_name")
  slug             String     @unique
  description      String?
  logoUrl          String?    @map("logo_url")
  bannerUrl        String?    @map("banner_url")
  contactEmail     String?    @map("contact_email")
  contactPhone     String?    @map("contact_phone")
  country          String     @default("DRC")
  region           String?
  city             String?
  physicalAddress  String?    @map("physical_address")
  status           ShopStatus @default(PENDING)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  vendorProfile VendorProfile  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  settings      ShopSettings?
  products      Product[]
  vendorOrders  VendorOrder[]

  @@index([vendorId])
  @@map("shops")
}

model ShopSettings {
  id              String   @id @default(uuid())
  shopId          String   @unique @map("shop_id")
  currency        String   @default("USD")
  returnPolicy    String?  @map("return_policy")
  shippingPolicy  String?  @map("shipping_policy")
  acceptsReturns  Boolean  @default(true) @map("accepts_returns")
  updatedAt       DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_settings")
}

// ---------------------------------------------------------------------------
// C. Product management
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id              String        @id @default(uuid())
  shopId          String        @map("shop_id")
  categoryId      String?       @map("category_id")
  name            String
  slug            String
  description     String?
  sku             String?
  price           Decimal       @db.Decimal(12, 2)
  compareAtPrice  Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  stockQuantity   Int           @default(0) @map("stock_quantity")
  status          ProductStatus @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  shop          Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category      Category?           @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  inventory     InventoryMovement[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@unique([shopId, slug])
  @@index([shopId])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  imageUrl      String   @map("image_url")
  isPrimary     Boolean  @default(false) @map("is_primary")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model InventoryMovement {
  id               String                 @id @default(uuid())
  productId        String                 @map("product_id")
  movementType     InventoryMovementType  @map("movement_type")
  quantityChanged  Int                    @map("quantity_changed")
  previousQuantity Int                    @map("previous_quantity")
  newQuantity      Int                    @map("new_quantity")
  referenceType    String?                @map("reference_type")
  referenceId      String?                @map("reference_id")
  performedBy      String?                @map("performed_by")
  createdAt        DateTime               @default(now()) @map("created_at")

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  performed User?   @relation(fields: [performedBy], references: [id])

  @@index([productId])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// D. Buyer shopping — cart, orders, multi-vendor fulfilment
// ---------------------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid())
  buyerId   String     @map("buyer_id")
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  buyer User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([buyerId, status])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                      String      @id @default(uuid())
  buyerId                 String      @map("buyer_id")
  orderNumber             String      @unique @map("order_number")
  shippingAddressSnapshot Json?       @map("shipping_address_snapshot")
  subtotal                Decimal     @default(0) @db.Decimal(12, 2)
  shippingFee             Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  totalAmount             Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  paymentStatus           PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus             OrderStatus   @default(PENDING) @map("order_status")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  buyer         User          @relation(fields: [buyerId], references: [id])
  vendorOrders  VendorOrder[]
  payments      Payment[]

  @@index([buyerId])
  @@map("orders")
}

model VendorOrder {
  id           String            @id @default(uuid())
  orderId      String            @map("order_id")
  shopId       String            @map("shop_id")
  vendorId     String            @map("vendor_id")
  subtotal     Decimal           @default(0) @db.Decimal(12, 2)
  shippingFee  Decimal           @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  status       VendorOrderStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop     Shop          @relation(fields: [shopId], references: [id])
  items    OrderItem[]
  shipments Shipment[]

  @@index([orderId])
  @@index([shopId])
  @@index([vendorId])
  @@map("vendor_orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  vendorOrderId  String   @map("vendor_order_id")
  productId      String?  @map("product_id")
  productName    String   @map("product_name")
  productImage   String?  @map("product_image")
  sku            String?
  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])

  @@index([vendorOrderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// E. Payments & delivery
// ---------------------------------------------------------------------------

model Payment {
  id                   String              @id @default(uuid())
  orderId              String              @map("order_id")
  transactionReference String?             @unique @map("transaction_reference")
  paymentProvider      String?             @map("payment_provider")
  paymentMethod        String?             @map("payment_method")
  amount               Decimal             @db.Decimal(12, 2)
  currency             String              @default("USD")
  status               PaymentRecordStatus @default(PENDING)
  paidAt               DateTime?           @map("paid_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model Shipment {
  id             String         @id @default(uuid())
  vendorOrderId  String         @map("vendor_order_id")
  courierName    String?        @map("courier_name")
  trackingNumber String?        @unique @map("tracking_number")
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?      @map("shipped_at")
  deliveredAt    DateTime?      @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([vendorOrderId])
  @@map("shipments")
}

// ---------------------------------------------------------------------------
// F. Audit trail
// ---------------------------------------------------------------------------

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("activity_logs")
}
